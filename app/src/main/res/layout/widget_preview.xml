<?xml version="1.0" encoding="utf-8"?>
<!-- Shown in the Android 12+ widget picker. Static copy of the real layout with sample text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:text="@string/widget_preview_quote"
        android:textColor="@color/widget_text"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:text="@string/widget_preview_author"
        android:textColor="@color/widget_text_dim"
        android:textSize="12sp"
        android:textStyle="italic" />

</LinearLayout>
