<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later. The same set as backup_rules.xml, declared for both cloud backup
  and direct device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="file"
            path="quotes.json" />
        <include
            domain="file"
            path="quotes.json.bak" />
        <include
            domain="sharedpref"
            path="commonplace.xml" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="file"
            path="quotes.json" />
        <include
            domain="file"
            path="quotes.json.bak" />
        <include
            domain="sharedpref"
            path="commonplace.xml" />
    </device-transfer>
</data-extraction-rules>
