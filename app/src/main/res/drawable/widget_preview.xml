<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview for the pre-Android-12 widget picker. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_surface" />
            <corners android:radius="16dp" />
            <size
                android:width="180dp"
                android:height="80dp" />
        </shape>
    </item>
    <item
        android:left="16dp"
        android:top="20dp"
        android:right="16dp"
        android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_text_dim" />
            <corners android:radius="3dp" />
            <size android:height="6dp" />
        </shape>
    </item>
</layer-list>
